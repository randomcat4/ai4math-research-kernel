[Unit]
Description=RK Product Research Daemon
After=network.target

[Service]
Type=simple
EnvironmentFile=@RK_ENV_FILE@
WorkingDirectory=@RK_INSTALL_ROOT@
ExecStart=@RK_DAEMON_EXECUTABLE@ @RK_DAEMON_ARGUMENTS@
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
